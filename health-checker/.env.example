# Copy to .env (or add to the project root .env alongside the Module 3 values)

# --- Target ---
HEALTH_CHECK_URL=http://backend:5000/api/health
TARGET_CONTAINER_NAME=ecommerce-backend

# --- Timing ---
CHECK_INTERVAL_SECONDS=30
HTTP_TIMEOUT_SECONDS=5
POST_RESTART_WAIT_SECONDS=8
VERIFY_RETRY_COUNT=3
VERIFY_RETRY_DELAY_SECONDS=5
FAILURE_THRESHOLD=2

# --- MongoDB (recovery logs) ---
MONGO_URI=mongodb://admin:adminpassword@mongo:27017/ecommerce?authSource=admin
MONGO_DB_NAME=ecommerce
RECOVERY_LOG_COLLECTION=recovery_logs

# --- SMTP email alerts ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
ALERT_FROM_EMAIL=your_email@gmail.com
ALERT_TO_EMAILS=you@example.com,teammate@example.com

# --- Docker access mode: sdk (in Compose) or cli (running on host) ---
DOCKER_MODE=sdk

# --- Prometheus metrics endpoint (Module 6) ---
METRICS_PORT=9200
